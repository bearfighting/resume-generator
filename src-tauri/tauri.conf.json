{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Resume Studio",
  "version": "0.1.0",
  "identifier": "local.resume.studio.phase0",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Local Resume Studio",
        "width": 900,
        "height": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/icon.png"],
    "category": "Productivity",
    "shortDescription": "Private, local-first resume editor"
  }
}
